# ai-voice GPU worker settings. Copy to worker.ini beside the exe.
# Every value here is the built-in default; the file only needs the lines you
# actually want to change.

# Auto | AlwaysOn | Off. The tray writes this line back when you change the mode,
# so your choice survives a reboot.
StartMode            = Auto

# --- GPU load thresholds. Measured idle baseline on spring, 150 samples at 1 Hz
#     on 2026-09-05: memory clock 810 MHz (zero variance), pstate P5 (150/150),
#     power 34.55-36.02 W, utilisation 5-6%, memory 388 MiB (zero variance).
#     Note what that rules out: "utilisation below 5%" can never be true here.
#
#     THE BUSY SIDE OF THESE FIVE IS NOT MEASURED. They are margins over the idle
#     ceiling, not observed values under a game. Run --calibrate, or
#     runtime/loadgen.py, before trusting them. See "What is not proven" in the
#     README.
MemClockBusyMhz      = 1500
PowerBusyWatts       = 70
UtilGpuBusyPct       = 25
Util3dBusyPct        = 20
IdlePStates          = P5,P8,P12

# --- The paused-game veto. Largest thing measured holding GPU memory on an idle
#     desktop was dwm at 169.4 MiB; largest non-shell process was CamoStudio at
#     112.3 MiB. 512 is three times that. This is the only signal that catches a
#     game paused at a menu, which draws nothing but still owns its VRAM.
ForeignVramBusyMiB   = 512

# --- Timing. Detection is fast, release is slow, on purpose: a false "busy"
#     costs one job, a false "idle" costs the user their game.
BusyConfirmSamples   = 3
ClearCooldownSeconds = 90
YieldGraceSeconds    = 2
FastPollMs           = 1000
# 2000, not 5000: this is the entire detection latency for an unknown game, which
# is caught by the VRAM veto and nothing else. Reading the counters in-process
# costs 98 ms (measured), so the slower poll bought almost nothing and cost three
# seconds of somebody's frame time.
CounterPollMs        = 2000

# --- What to run when the GPU is ours. Empty means detection only, which is what
#     this proof of concept ships as. runtime/provision.ps1 prints the two lines
#     to paste here once the runtime is installed.
# JobCommand         = C:\Users\you\AppData\Local\ai-voice-worker\runtime\.venv\Scripts\python.exe
# JobArguments       = "C:\...\runtime\runner.py" --queue "C:\...\ai-voice-worker\queue"
# JobWorkingDir      =

# --- To exercise the yield path with no Python and no GPU, point JobCommand at
#     runtime\fake_job.ps1 instead. Add -Stubborn to make it ignore YIELD and
#     force the job-object kill, which is the path the real runtime relies on.
# JobCommand         = C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe
# JobArguments       = -ExecutionPolicy Bypass -NoProfile -File C:\...\runtime\fake_job.ps1

# --- Comma separated. Add whatever else gets played on this machine. This list is
#     hand-maintained and will be wrong: Epic, Game Pass, GOG and Battle.net set
#     no Steam RunningAppID, so for those the VRAM veto is the only backstop.
GameProcessNames     = cs2,RainbowSix,RainbowSixGame,ReadyOrNot,GRB,VALORANT-Win64-Shipping,VALORANT,LeagueOfLegends
