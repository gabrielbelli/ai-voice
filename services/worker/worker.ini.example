# ai-voice GPU worker settings. Copy to worker.ini beside the exe.
# Every value here is the built-in default; the file only needs the lines you
# actually want to change.

# --- GPU load thresholds. Measured idle baseline on spring, 92 samples over 90s:
#     memory clock 810 MHz (zero variance), pstate P5 (92/92),
#     power 33.68-35.13 W, utilisation 5-6%.
MemClockBusyMhz      = 1500
PowerBusyWatts       = 70
UtilGpuBusyPct       = 25
Util3dBusyPct        = 20
IdlePStates          = P5,P8,P12

# --- The paused-game veto. Largest thing measured holding GPU memory on an idle
#     desktop was dwm at 172 MiB; largest non-system process was CamoStudio at
#     112 MiB. 512 is three times that.
ForeignVramBusyMiB   = 512

# --- Timing. Detection is fast, release is slow, on purpose: a false "busy"
#     costs one job, a false "idle" costs the user their game.
BusyConfirmSamples   = 3
ClearCooldownSeconds = 90
YieldGraceSeconds    = 5
FastPollMs           = 1000
CounterPollMs        = 5000

# --- What to run when the GPU is ours. Empty means detection only, which is what
#     this proof of concept ships as. See runtime/provision.ps1.
# JobCommand         = C:\ai-voice-worker\runtime\python\python.exe
# JobArguments       = -m worker.run --gateway http://orko:30080
# JobWorkingDir      = C:\ai-voice-worker\runtime

# --- Comma separated. Add whatever else gets played on this machine.
GameProcessNames     = cs2,RainbowSix,RainbowSixGame,ReadyOrNot,GRB,VALORANT-Win64-Shipping,VALORANT,LeagueOfLegends
